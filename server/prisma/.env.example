# Detailer Server Environment Variables
# Copy this file to .env and fill in the values

# Environment (development, staging, production)
PRISMA_ENV=production
DEBUG=False

# Database Configuration
# Option 1: Use DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Option 2: Use individual variables
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=host
# POSTGRES_DB=database_name
# POSTGRES_PORT=5432

# Redis (for Django Channels and Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1  # Use DB 1 (support server uses DB 0)

# Django Secret Key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-secret-key-here

# JWT Settings
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# Support Server API Connection (NEW FOR CREW CHAT)
SUPPORT_API_URL=https://support.prismavalet.com/api/v1
SUPPORT_INTERNAL_API_KEY=your-secure-random-key-here  # MUST MATCH support server key

# Email Configuration (for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@prismavalet.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=crew@prismavalet.com

# Google Cloud Storage (for media files in staging/production)
GS_BUCKET_NAME=prisma_crew_bucket
GS_LOCATION=crew-app
# GS_CREDENTIALS_PATH=/path/to/credentials.json

# Twilio (for SMS notifications)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Expo)
# EXPO_PUSH_TOKEN=your-expo-token

# CORS Settings
CORS_ALLOWED_ORIGINS=https://crew.prismavalet.com,https://app.prismavalet.com

# Allowed Hosts
ALLOWED_HOSTS=crew.prismavalet.com,localhost,127.0.0.1

# Celery (background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Channels (WebSockets) - NEW FOR CREW CHAT
ASGI_APPLICATION=prisma.asgi.application

# Database Connection Pooling
DATABASE_CONN_MAX_AGE=600

# Static/Media Files
STATIC_URL=/static/
MEDIA_URL=/media/

# Sentry (optional, for error tracking)
# SENTRY_DSN=https://your-sentry-dsn

# Stripe (for payments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Client App URL (for links in notifications)
CLIENT_APP_URL=https://client.prismavalet.com
